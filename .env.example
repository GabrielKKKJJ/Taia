# Copie este arquivo para .env e preencha. NUNCA versione o .env (já está no .gitignore).

# Obrigatório — token de acesso pessoal do Canvas.
# Gere em https://lms.jala.university/profile/settings > Tokens de acesso aprovados.
CANVAS_TOKEN=

# Alternativa temporária ao CANVAS_TOKEN, se a Jala tiver desabilitado a criação de
# tokens: cole aqui o cookie de sessão do navegador (F12 > Application > Cookies).
# Expira em horas ou dias — só use se o token não for uma opção.
# CANVAS_COOKIE=

# Opcionais — só se você for usar o painel (npm run painel) pra rodar o agente com
# outro provedor além do Claude direto. Também dá pra preencher pela aba
# Configurações do painel, que grava aqui.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
